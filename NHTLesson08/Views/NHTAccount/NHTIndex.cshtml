@model IEnumerable<NHTLesson08.Models.NHTAccount>

@{
    ViewData["Title"] = "NHTIndex";
}

<h1>NHTIndex</h1>

<p>
    <a asp-action="NHTCreate" asp-controller="NHTAccount" class="btn btn-primary">Tạo mới</a>

</p>
<table class="table">
