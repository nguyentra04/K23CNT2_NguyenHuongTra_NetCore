
@{
    ViewData["Title"] = "NHTCreate";
}

@model NHTLesson06.Models.NHTEmployee

<h2>Thêm nhân viên mới</h2>

<form asp-action="NHTCreateSubmit" method="post">
    <div class="mb-3">
        <label class="form-label">ID</label>
        <input asp-for="NHTId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input asp-for="NHTName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Ngày sinh</label>
        <input asp-for="NHTBirthDay" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="NHTEmail" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Số điện thoại</label>
        <input asp-for="NHTPhone" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Lương</label>
        <input asp-for="NHTSalary" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Trạng thái</label>
        <select asp-for="NHTStatus" class="form-select">
            <option value="true">Đang làm</option>
            <option value="false">Nghỉ việc</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Lưu lại</button>
    <a asp-action="NHTIndex" class="btn btn-secondary">Quay lại</a>
</form>


