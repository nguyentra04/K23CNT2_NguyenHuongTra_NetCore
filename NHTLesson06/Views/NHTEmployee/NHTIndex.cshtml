@model List<NHTLesson06.Models.NHTEmployee>

@{
    ViewBag.Title = "Danh sách nhân viên";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="mb-3">
    <a href="@Url.Action("NHTCreate", "NHTEmployee")" class="btn btn-primary">Thêm nhân viên mới</a>
</div>

<div class="container mt-4">
    <h2 class="mb-3">Danh sách nhân viên</h2>
    <table class="table table-bordered table-striped">
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Lương</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var NHTemp in Model)
        {
            <tr>
                <td>@NHTemp.NHTId</td>
                <td>@NHTemp.NHTName</td>
                <td>@NHTemp.NHTBirthDay.ToShortDateString()</td>
                <td>@NHTemp.NHTEmail</td>
                <td>@NHTemp.NHTPhone</td>
                <td>@NHTemp.NHTSalary.ToString("N0") đ</td>
                <td>   
                        @if (NHTemp.NHTStatus)
                        {
                            <span class="badge bg-success">Đang làm</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nghỉ/Thực tập</span>
                        }
                </td>
  
                <td>
                    <a href="@Url.Action("NHTEdit", "NHTEmployee", new { id = NHTemp.NHTId })" class="btn btn-warning btn-sm">Sửa</a>
                    <a href="@Url.Action("NHTDelete", "NHTEmployee", new { id = NHTemp.NHTId })" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
